generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      Tag[]    @relation("NoteTags")

  @@index([updatedAt])
  @@index([title])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  notes Note[] @relation("NoteTags")
}
